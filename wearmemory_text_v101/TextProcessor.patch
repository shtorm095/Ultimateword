+    private func retryPieceOrFail(
+        item: TextQueueItem,
+        sourceURL: URL,
+        pieces: [URL],
+        index: Int,
+        texts: [String],
+        pieceAttempt: Int,
+        forceOnDevice: Bool,
+        message: String
+    ) {
+        if pieceAttempt < 2 {
+            let nextAttempt = pieceAttempt + 1
+            publishStatus("Speech: повтор части \(nextAttempt + 1)/3")
+            workQueue.asyncAfter(deadline: .now() + 1.5) {
+                self.recognizePieces(
+                    item: item,
+                    sourceURL: sourceURL,
+                    pieces: pieces,
+                    index: index,
+                    texts: texts,
+                    pieceAttempt: nextAttempt,
+                    forceOnDevice: forceOnDevice
+                )
+            }
+        } else {
+            appendDiagnostic(itemID: item.id, pieceIndex: index, message: message)
+            finishFailure(itemID: item.id, message: message)
+        }
+    }
+
+    private func describeSpeechError(_ error: Error) -> String {
+        var parts: [String] = []
+        var current: NSError? = error as NSError
+        var depth = 0
+        while let value = current, depth < 4 {
+            var piece = "\(value.domain) \(value.code): \(value.localizedDescription)"
+            if let reason = value.localizedFailureReason, !reason.isEmpty { piece += " | reason: \(reason)" }
+            if let suggestion = value.localizedRecoverySuggestion, !suggestion.isEmpty { piece += " | recovery: \(suggestion)" }
+            parts.append(piece)
+            current = value.userInfo[NSUnderlyingErrorKey] as? NSError
+            depth += 1
+        }
+        return "Speech " + parts.joined(separator: " -> ")
+    }
+
+    private func savePartial(_ text: String, itemID: String, pieceIndex: Int) {
+        guard !text.isEmpty else { return }
+        do {
+            try ensureDirectories()
+            let url = partialURL(for: itemID)
+            let line = "[piece \(pieceIndex + 1)] \(text)\n"
+            let existing = (try? String(contentsOf: url, encoding: .utf8)) ?? ""
+            if !existing.contains(line) {
+                try (existing + line).write(to: url, atomically: true, encoding: .utf8)
+            }
+        } catch {
+            appendDiagnostic(itemID: itemID, pieceIndex: pieceIndex, message: "Не удалось сохранить partial: \(error.localizedDescription)")
+        }
+    }
+
+    private func appendDiagnostic(itemID: String, pieceIndex: Int, message: String) {
+        do {
+            try ensureDirectories()
+            let f = ISO8601DateFormatter()
+            let line = "[\(f.string(from: Date()))] item=\(itemID) piece=\(pieceIndex + 1) \(message)\n"
+            let url = diagnosticsURL
+            if fm.fileExists(atPath: url.path), let handle = try? FileHandle(forWritingTo: url) {
+                defer { try? handle.close() }
+                try handle.seekToEnd()
+                if let data = line.data(using: .utf8) { try handle.write(contentsOf: data) }
+            } else {
+                try line.write(to: url, atomically: true, encoding: .utf8)
+            }
+        } catch {
+            NSLog("WearMemoryText diagnostics write failed: %@", error.localizedDescription)
+        }
+    }
