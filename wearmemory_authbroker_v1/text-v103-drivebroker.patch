+private enum TextDriveCredentialStore {
+    private static let appGroup = "group.local.pavel.WearMemory"
+    private static let fileName = "text-google-drive.json"
+
+    private struct Credential: Codable {
+        let version: Int
+        let module: String
+        let folderID: String
+        let refreshToken: String
+        let updatedAt: Date
+    }
+
+    static func refreshToken(folderID: String) -> String? {
+        guard let root = FileManager.default.containerURL(forSecurityApplicationGroupIdentifier: appGroup) else { return nil }
+        let url = root.appendingPathComponent("Auth", isDirectory: true).appendingPathComponent(fileName)
+        guard let data = try? Data(contentsOf: url) else { return nil }
+        let decoder = JSONDecoder(); decoder.dateDecodingStrategy = .iso8601
+        guard let credential = try? decoder.decode(Credential.self, from: data),
+              credential.module == "text", credential.folderID == folderID, !credential.refreshToken.isEmpty else { return nil }
+        return credential.refreshToken
+    }
+
+    static func lastBrokerError() -> String? {
+        guard let root = FileManager.default.containerURL(forSecurityApplicationGroupIdentifier: appGroup) else {
+            return "Общая папка WearMemory недоступна"
+        }
+        let url = root.appendingPathComponent("Auth", isDirectory: true).appendingPathComponent("text-drive-error.txt")
+        if let data = try? Data(contentsOf: url), let text = String(data: data, encoding: .utf8), !text.isEmpty { return text }
+        return "Google Drive для Text не подключён"
+    }
+
+    static func deleteCredential() {
+        guard let root = FileManager.default.containerURL(forSecurityApplicationGroupIdentifier: appGroup) else { return }
+        let dir = root.appendingPathComponent("Auth", isDirectory: true)
+        try? FileManager.default.removeItem(at: dir.appendingPathComponent(fileName))
+        try? FileManager.default.removeItem(at: dir.appendingPathComponent("text-drive-error.txt"))
     }
 }
