+            queue[qIndex].currentPartialText = nil
+            queue[qIndex].warnings = warnings
+            queue[qIndex].nextPieceIndex = index + 1
+            queue[qIndex].completedPieceTexts = newTexts
+            saveQueue(queue)
+        }
+        publishStatus("Часть \(index + 1) пропущена после 3 сбоев · продолжаю")
