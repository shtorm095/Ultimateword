+    private func queueItem(id: String) -> TextQueueItem? {
+        loadQueue().first { $0.id == id }
+    }
+
+    private func persistProgress(itemID: String, nextPieceIndex: Int, completedTexts: [String], warnings: [String]) {
+        var queue = loadQueue()
+        if let index = queue.firstIndex(where: { $0.id == itemID }) {
+            queue[index].nextPieceIndex = nextPieceIndex
+            queue[index].completedPieceTexts = completedTexts
+            queue[index].currentPartialText = nil
+            queue[index].warnings = warnings
+            queue[index].attempts = 0
+            queue[index].lastError = nil
+            queue[index].nextRetryAt = nil
+            queue[index].state = .processing
+            saveQueue(queue)
+        }
+    }
+
+    private func persistPartial(itemID: String, text: String) {
+        workQueue.async { [weak self] in
+            guard let self = self else { return }
+            var queue = self.loadQueue()
+            if let index = queue.firstIndex(where: { $0.id == itemID }) {
+                queue[index].currentPartialText = text
+                self.saveQueue(queue)
+            }
+        }
+    }
+
+    private func persistDiagnostic(itemID: String, details: String, partial: String) {
+        var queue = loadQueue()
+        if let index = queue.firstIndex(where: { $0.id == itemID }) {
+            queue[index].lastUnderlyingError = details
+            if !partial.isEmpty { queue[index].currentPartialText = partial }
+            saveQueue(queue)
+        }
+    }
+
+    private func describe(_ error: Error) -> String {
+        let ns = error as NSError
+        var parts = ["\(ns.domain) \(ns.code): \(ns.localizedDescription)"]
+        if let reason = ns.localizedFailureReason, !reason.isEmpty { parts.append("reason=\(reason)") }
+        if let suggestion = ns.localizedRecoverySuggestion, !suggestion.isEmpty { parts.append("recovery=\(suggestion)") }
+        if let underlying = ns.userInfo[NSUnderlyingErrorKey] as? NSError {
+            parts.append("underlying=\(underlying.domain) \(underlying.code): \(underlying.localizedDescription)")
+        }
+        let safeExtras = ns.userInfo.compactMap { key, value -> String? in
+            let k = String(describing: key)
+            guard k != NSUnderlyingErrorKey, k != NSLocalizedDescriptionKey, k != NSLocalizedFailureReasonErrorKey, k != NSLocalizedRecoverySuggestionErrorKey else { return nil }
+            let v = String(describing: value)
+            guard v.count <= 240 else { return "\(k)=\(v.prefix(240))…" }
+            return "\(k)=\(v)"
+        }.sorted()
+        if !safeExtras.isEmpty { parts.append("userInfo={\(safeExtras.joined(separator: ", "))}") }
+        return parts.joined(separator: " | ")
+    }
+
